<%- include('partials/header') %>
    <main id="main-content" class="container content-section">
        <header class="page-intro">
            <p class="eyebrow">Get involved</p>
            <h1>
                <%= title %>
            </h1>
            <p>Explore upcoming opportunities to support and strengthen the community.</p>
        </header>

        <section class="project-grid" aria-label="Upcoming service projects">
            <% if (projects && projects.length> 0) { %>
                <% projects.forEach((project)=> { %>
                    <article class="project-card">
                        <p class="eyebrow">
                            <%= new Date(`${project.date}T00:00:00`).toLocaleDateString('en-ZA', { day: 'numeric' ,
                                month: 'long' , year: 'numeric' }) %>
                        </p>
                        <h2>
                            <%= project.title %>
                        </h2>
                        <p>
                            <%= project.description %>
                        </p>
                        <p><strong>Organization:</strong>
                            <%= project.organization_name %>
                        </p>
                        <p><strong>Location:</strong>
                            <%= project.location %>
                        </p>
                    </article>
                    <% }); %>
                        <% } else { %>
                            <p>No service projects are currently available. Please check back soon.</p>
                            <% } %>
        </section>
    </main>
    <%- include('partials/footer') %>