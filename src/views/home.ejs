<%- include('partials/header') %>
    <main id="main-content" class="container">
        <section class="hero">
            <p class="eyebrow">Connect. Serve. Strengthen.</p>
            <h1>
                <%= title %>
            </h1>
            <p class="hero-copy">Our mission is to promote service across the world by connecting volunteers with
                service opportunities in their communities.</p>
            <a class="primary-link" href="/projects">Explore service projects</a>
            <img class="hero-image" src="/images/cse340-service-network.png" alt="CSE 340 Service Network logo">
        </section>
        <section class="content-section">
            <h2>Find a way to make a difference</h2>
            <div class="feature-grid">
                <article class="feature-card">
                    <h3>Our organizations</h3>
                    <p>Meet the groups working to make a positive impact.</p><a href="/organizations">View
                        organizations</a>
                </article>
                <article class="feature-card">
                    <h3>Service projects</h3>
                    <p>Discover activities where your time and effort can help.</p><a href="/projects">View projects</a>
                </article>
                <article class="feature-card">
                    <h3>Project categories</h3>
                    <p>Explore service opportunities by area of interest.</p><a href="/categories">Browse categories</a>
                </article>
            </div>
        </section>
    </main>
    <%- include('partials/footer') %>