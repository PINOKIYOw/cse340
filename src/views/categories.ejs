<%- include('partials/header') %>
    <main id="main-content" class="container content-section categories-page">
        <header class="page-intro">
            <p class="eyebrow">Find your cause</p>
            <h1>
                <%= title %>
            </h1>
            <p>Explore service project categories and discover opportunities to make a positive difference in the
                community.</p>
        </header>
        <section class="categories-grid" aria-label="Service project categories">
            <article class="category-card"><span class="category-number" aria-hidden="true">01</span>
                <h2>Environmental</h2>
                <p>Projects focused on protecting and improving the environment.</p>
            </article>
            <article class="category-card"><span class="category-number" aria-hidden="true">02</span>
                <h2>Educational</h2>
                <p>Opportunities to support learning, education and development.</p>
            </article>
            <article class="category-card"><span class="category-number" aria-hidden="true">03</span>
                <h2>Community Service</h2>
                <p>Activities that strengthen and support local communities.</p>
            </article>
            <article class="category-card"><span class="category-number" aria-hidden="true">04</span>
                <h2>Health and Wellness</h2>
                <p>Projects that promote health, wellbeing and healthy communities.</p>
            </article>
        </section>
    </main>
    <%- include('partials/footer') %>