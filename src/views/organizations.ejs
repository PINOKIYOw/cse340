<%- include('partials/header') %>
    <main id="main-content" class="container content-section">
        <header class="page-intro">
            <p class="eyebrow">Working together</p>
            <h1>
                <%= title %>
            </h1>
            <p>Here are a few of our partner organizations:</p>
        </header>
        <section class="organization-grid" aria-label="Partner organizations">
            <article class="organization-card"><img src="/images/brightfuture-logo.png"
                    alt="BrightFuture Builders logo">
                <div>
                    <h2>BrightFuture Builders</h2>
                    <p><a href="mailto:info@brightfuture.org">info@brightfuture.org</a></p>
                </div>
            </article>
            <article class="organization-card"><img src="/images/greenharvest-logo.png" alt="GreenHarvest Growers logo">
                <div>
                    <h2>GreenHarvest Growers</h2>
                    <p><a href="mailto:contact@greenharvest.org">contact@greenharvest.org</a></p>
                </div>
            </article>
            <article class="organization-card"><img src="/images/unityserve-logo.png" alt="UnityServe Volunteers logo">
                <div>
                    <h2>UnityServe Volunteers</h2>
                    <p><a href="mailto:hello@unityserve.org">hello@unityserve.org</a></p>
                </div>
            </article>
        </section>
    </main>
    <%- include('partials/footer') %>